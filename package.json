{
  "name": "dughri",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "check:js": "node scripts/check-js.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:kotlin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-correlator.ps1",
    "android:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-android-toolchain.ps1",
    "android:guarded": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:installed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installed-android.ps1"
  },
  "dependencies": {
    "expo": "~58.0.14",
    "expo-constants": "58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "58.0.13",
    "expo-modules-core": "~58.0.22",
    "expo-router": "58.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
